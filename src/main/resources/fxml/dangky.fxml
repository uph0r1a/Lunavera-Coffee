<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="registerRoot"
           stylesheets="@../css/dangky.css"
           xmlns="http://javafx.com/javafx/26"
           xmlns:fx="http://javafx.com/fxml/1">

    <!-- Background -->
    <ImageView fx:id="backgroundImage"
               mouseTransparent="true"
               preserveRatio="false"
               smooth="true">
        <image>
            <Image url="@../images/LoginBackgroung.png"/>
        </image>
    </ImageView>

    <Region fx:id="backgroundOverlay"
            mouseTransparent="true"
            styleClass="background-overlay"/>

    <!-- Main content -->
    <BorderPane fx:id="mainContent"
                maxHeight="800"
                maxWidth="1400">

        <!-- Left decorative panel -->
        <left>
            <VBox fx:id="leftPanel"
                  alignment="CENTER"
                  maxWidth="650"
                  prefWidth="650"
                  spacing="12">
                <padding>
                    <Insets top="40"
                            right="40"
                            bottom="40"
                            left="40"/>
                </padding>
            </VBox>
        </left>

        <!-- Registration panel -->
        <right>
            <VBox fx:id="rightPanel"
                  alignment="CENTER"
                  maxWidth="800"
                  prefWidth="800">
                <padding>
                    <Insets top="40"
                            right="80"
                            bottom="40"
                            left="20"/>
                </padding>

                <VBox fx:id="registerCard"
                      alignment="TOP_CENTER"
                      maxWidth="510"
                      maxHeight="750"
                      prefWidth="510"
                      prefHeight="750"
                      spacing="10"
                      styleClass="register-card">

                    <padding>
                        <Insets top="25"
                                right="30"
                                bottom="28"
                                left="30"/>
                    </padding>

                    <!-- Logo -->
                    <VBox alignment="CENTER" prefHeight="100.0">
                        <ImageView fitHeight="100.0" fitWidth="130.0" preserveRatio="true">
                            <image>
                                <Image url="@../images/LunaveraLogo.png"/>
                            </image>
                        </ImageView>
                    </VBox>

                    <!-- Title -->
                    <Label fx:id="registerTitle"
                           styleClass="register-title"
                           text="ĐĂNG KÝ TÀI KHOẢN"/>

                    <!-- ==================== CUSTOMER INFO ==================== -->

                    <!-- Customer.full_name -->
                    <VBox maxWidth="410"
                          prefWidth="410"
                          spacing="5"
                          styleClass="input-group">

                        <Label styleClass="input-label"
                               text="Họ và tên"/>

                        <TextField fx:id="fullNameField"
                                   prefHeight="44"
                                   prefWidth="410"
                                   promptText="Nhập họ và tên"
                                   styleClass="input-field"/>
                    </VBox>

                    <!-- Customer.phone -->
                    <VBox maxWidth="410"
                          prefWidth="410"
                          spacing="5"
                          styleClass="input-group">

                        <Label styleClass="input-label"
                               text="Số điện thoại"/>

                        <TextField fx:id="phoneField"
                                   prefHeight="44"
                                   prefWidth="410"
                                   promptText="Nhập số điện thoại"
                                   styleClass="input-field"/>
                    </VBox>

                    <!-- ==================== USER INFO ==================== -->

                    <!-- User.username -->
                    <VBox maxWidth="410"
                          prefWidth="410"
                          spacing="5"
                          styleClass="input-group">

                        <Label styleClass="input-label"
                               text="Tên đăng nhập"/>

                        <TextField fx:id="usernameField"
                                   prefHeight="44"
                                   prefWidth="410"
                                   promptText="Nhập tên đăng nhập"
                                   styleClass="input-field"/>
                    </VBox>

                    <!-- User.password -->
                    <VBox maxWidth="410"
                          prefWidth="410"
                          spacing="5"
                          styleClass="input-group">

                        <Label styleClass="input-label"
                               text="Mật khẩu"/>

                        <HBox maxWidth="410"
                              prefWidth="410"
                              spacing="5">

                            <PasswordField fx:id="passwordField"
                                           prefHeight="44"
                                           promptText="Nhập mật khẩu"
                                           styleClass="input-field"
                                           HBox.hgrow="ALWAYS"/>

                            <Button fx:id="showPasswordButton"
                                    focusTraversable="false"
                                    prefHeight="44"
                                    prefWidth="40"
                                    styleClass="password-button"
                                    text="◉"/>
                        </HBox>
                    </VBox>

                    <!-- Confirm password - UI only, not a DB field -->
                    <VBox maxWidth="410"
                          prefWidth="410"
                          spacing="5"
                          styleClass="input-group">

                        <Label styleClass="input-label"
                               text="Nhập lại mật khẩu"/>

                        <HBox maxWidth="410"
                              prefWidth="410"
                              spacing="5">

                            <PasswordField fx:id="confirmPasswordField"
                                           prefHeight="44"
                                           promptText="Nhập lại mật khẩu"
                                           styleClass="input-field"
                                           HBox.hgrow="ALWAYS"/>

                            <Button fx:id="showConfirmPasswordButton"
                                    focusTraversable="false"
                                    prefHeight="44"
                                    prefWidth="40"
                                    styleClass="password-button"
                                    text="◉"/>
                        </HBox>
                    </VBox>

                    <!-- Register -->
                    <Region prefHeight="15"/>

                    <Button fx:id="registerButton"
                            defaultButton="true"
                            prefHeight="46"
                            prefWidth="410"
                            styleClass="register-button"
                            text="ĐĂNG KÝ   →"/>

                    <!-- Separator -->
                    <HBox alignment="CENTER"
                          maxWidth="410"
                          prefWidth="410"
                          spacing="15">

                        <Region HBox.hgrow="ALWAYS"
                                styleClass="separator"/>

                        <Label styleClass="separator-star"
                               text="✦"/>

                        <Region HBox.hgrow="ALWAYS"
                                styleClass="separator"/>
                    </HBox>

                    <!-- Login -->
                    <HBox alignment="CENTER"
                          spacing="5">

                        <Label fx:id="loginText"
                               styleClass="login-text"
                               text="Đã có tài khoản?"/>

                        <Hyperlink fx:id="loginLink"
                                   styleClass="login-link"
                                   text="Đăng nhập ngay"/>
                    </HBox>

                </VBox>
            </VBox>
        </right>

    </BorderPane>

</StackPane>