<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="quanLyDonHangRoot"
            prefWidth="1600.0"
            prefHeight="1000.0"
            minWidth="1600.0"
            minHeight="1000.0"
            maxWidth="1600.0"
            maxHeight="1000.0"
            styleClass="dashboard"
            stylesheets="@../css/quanlydonhang.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.OrderController">

    <!-- ========================================================= -->
    <!-- SIDEBAR -->
    <!-- ========================================================= -->
    <left>
        <VBox prefWidth="270.0"
              maxWidth="270.0"
              styleClass="sidebar">

            <!-- LOGO -->
            <VBox alignment="CENTER" prefHeight="150.0">
                <ImageView fitHeight="100.0" fitWidth="180.0" preserveRatio="true">
                    <image>
                        <Image url="@../images/LunaveraLogo.png"/>
                    </image>
                </ImageView>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <!-- MENU 1 -->
            <VBox spacing="6.0" VBox.vgrow="NEVER">
                <Button text="⌂   Trang chủ"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openDashboard"/>

                <Button fx:id="productMenuButton"
                        text="▣   Quản lý sản phẩm"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openProductManagement"/>

                <Button text="▤   Quản lý đơn hàng"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button,menu-button-active"/>

                <Button text="♙   Quản lý khách hàng"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openCustomerManagement"/>
            </VBox>

            <Separator fx:id="categorySeparator" styleClass="sidebar-separator"/>

            <!-- MENU 2 -->
            <VBox fx:id="adminMenuBox" spacing="6.0">
                <Button fx:id="categoryMenuButton"
                        text="▦   Quản lý danh mục"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openCategoryManagement"/>

                <Button fx:id="accountMenuButton"
                        text="♙   Quản lý tài khoản"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openAccountManagement"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- LOGOUT -->
            <VBox alignment="CENTER_LEFT" spacing="8.0">
                <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                </padding>

                <Button text="←   Đăng xuất"
                        prefHeight="42.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="logout-button"
                        onAction="#logout"/>

                <Label text="Cà phê ngon&#10;Ngày thêm tốt đẹp"
                       styleClass="sidebar-footer"/>
            </VBox>
        </VBox>
    </left>


    <!-- ========================================================= -->
    <!-- MAIN CONTENT -->
    <!-- ========================================================= -->
    <center>
        <VBox spacing="16.0" styleClass="content">
            <padding>
                <Insets top="20.0" right="24.0" bottom="20.0" left="24.0"/>
            </padding>

            <!-- ================= HEADER ================= -->
            <HBox alignment="CENTER_LEFT"
                  spacing="12.0"
                  prefHeight="68.0"
                  styleClass="page-header">

                <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                    <Label text="Quản lý đơn hàng" styleClass="page-title"/>
                    <Label text="Sơ đồ bàn, tạo đơn phục vụ và quản lý hóa đơn thanh toán"
                           styleClass="page-description"/>
                </VBox>

                <Button fx:id="orderHistoryButton"
                        text="▤  Lịch sử đơn hàng"
                        prefHeight="42.0"
                        styleClass="secondary-button"
                        onAction="#handleShowOrderHistory"/>

                <Label text="♧" styleClass="header-icon"/>

                <VBox alignment="CENTER_RIGHT" spacing="2.0">
                    <Label fx:id="adminNameLabel" text="Admin" styleClass="admin-name"/>
                    <Label fx:id="adminRoleLabel" text="Quản trị viên" styleClass="admin-role"/>
                </VBox>

                <Label text="◎" styleClass="profile-icon"/>
            </HBox>


            <!-- ================= MAIN LAYOUT ================= -->
            <HBox spacing="18.0" VBox.vgrow="ALWAYS">

                <!-- ================= LEFT: SƠ ĐỒ BÀN (3 CỘT x 4 DÒNG) ================= -->
                <VBox prefWidth="440.0"
                      minWidth="420.0"
                      maxWidth="460.0"
                      spacing="14.0"
                      HBox.hgrow="NEVER"
                      styleClass="content-card">
                    <padding>
                        <Insets top="16.0" right="16.0" bottom="16.0" left="16.0"/>
                    </padding>

                    <!-- TABLE HEADER -->
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <Label text="Sơ đồ bàn phục vụ" styleClass="section-title"/>
                            <Label text="Chọn bàn để tạo mới hoặc xem đơn"
                                   styleClass="section-subtitle"/>
                        </VBox>

                        <!-- STATUS LEGENDS -->
                        <HBox spacing="10.0" alignment="CENTER">
                            <HBox spacing="4.0" alignment="CENTER">
                                <Label text="●" styleClass="status-dot-occupied"/>
                                <Label text="Đang dùng" styleClass="status-legend-text"/>
                            </HBox>

                            <HBox spacing="4.0" alignment="CENTER">
                                <Label text="●" styleClass="status-dot-empty"/>
                                <Label text="Trống" styleClass="status-legend-text"/>
                            </HBox>
                        </HBox>
                    </HBox>

                    <!-- TABLE GRID (3x4 = 12 BÀN) -->
                    <GridPane fx:id="tableGrid"
                              hgap="10.0"
                              vgap="10.0"
                              VBox.vgrow="ALWAYS">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="33.333" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="33.333" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="33.333" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints percentHeight="25.0" vgrow="ALWAYS"/>
                            <RowConstraints percentHeight="25.0" vgrow="ALWAYS"/>
                            <RowConstraints percentHeight="25.0" vgrow="ALWAYS"/>
                            <RowConstraints percentHeight="25.0" vgrow="ALWAYS"/>
                        </rowConstraints>
                    </GridPane>

                    <!-- SELECTED TABLE ACTION BAR -->
                    <VBox spacing="8.0" styleClass="selected-table">
                        <padding>
                            <Insets top="10.0" right="12.0" bottom="10.0" left="12.0"/>
                        </padding>

                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label fx:id="selectedTableLabel"
                                   text="Bàn 1"
                                   styleClass="selected-table-title"/>
                            <Label fx:id="selectedTableStatusLabel"
                                   text="Không hoạt động"
                                   styleClass="empty-badge"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="selectedTableCapacityLabel"
                                   text="Sức chứa: 4 người"
                                   styleClass="selected-table-info"/>
                        </HBox>

                        <HBox spacing="8.0" alignment="CENTER">
                            <Button fx:id="startOrderButton"
                                    text="▶ Đặt đơn"
                                    prefHeight="36.0"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="1.7976931348623157E308"
                                    onAction="#handleStartOrder"
                                    styleClass="primary-button"/>

                            <Button fx:id="toggleStatusButton"
                                    text="⇄ Đổi trạng thái"
                                    prefHeight="36.0"
                                    HBox.hgrow="ALWAYS"
                                    maxWidth="1.7976931348623157E308"
                                    onAction="#handleToggleTableStatus"
                                    styleClass="secondary-button"/>

                            <Button fx:id="tableDetailButton"
                                    text="Chi tiết"
                                    prefHeight="36.0"
                                    onAction="#handleTableDetail"
                                    styleClass="secondary-button"/>
                        </HBox>
                    </VBox>
                </VBox>


                <!-- ================= RIGHT: THÔNG TIN ĐƠN & THỰC ĐƠN ================= -->
                <VBox spacing="10.0"
                      HBox.hgrow="ALWAYS"
                      styleClass="content-card">
                    <padding>
                        <Insets top="14.0" right="16.0" bottom="14.0" left="16.0"/>
                    </padding>

                    <!-- ORDER HEADER -->
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <Label text="Đơn hàng hiện tại" styleClass="section-title"/>
                            <Label text="Thông tin chi tiết và gọi món theo bàn đã chọn"
                                   styleClass="section-subtitle"/>
                        </VBox>

                        <Label fx:id="orderStatusLabel"
                               text="Không hoạt động"
                               styleClass="order-status-badge-empty"/>
                    </HBox>

                    <!-- ORDER INFO METRICS & CUSTOMER INPUT -->
                    <GridPane hgap="12.0"
                              vgap="8.0"
                              styleClass="order-info-card">
                        <padding>
                            <Insets top="10.0" right="12.0" bottom="10.0" left="12.0"/>
                        </padding>
                        <columnConstraints>
                            <ColumnConstraints percentWidth="30.0" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="30.0" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="40.0" hgrow="ALWAYS"/>
                        </columnConstraints>

                        <!-- Row 0: Mã đơn, Vị trí bàn, Thời gian thực -->
                        <VBox spacing="2.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Mã đơn hàng" styleClass="info-label"/>
                            <Label fx:id="orderIdLabel" text="-" styleClass="info-value"/>
                        </VBox>

                        <VBox spacing="2.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Vị trí phục vụ" styleClass="info-label"/>
                            <Label fx:id="orderTableLabel" text="Bàn 1 (Tầng 1)" styleClass="info-value"/>
                        </VBox>

                        <VBox spacing="2.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <Label text="Thời gian (Thời gian thực)" styleClass="info-label"/>
                            <Label fx:id="orderTimeLabel" text="-" styleClass="info-value"/>
                        </VBox>

                        <!-- Row 1: Khách hàng (Họ tên & Số điện thoại) -->
                        <VBox spacing="2.0" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1">
                            <Label text="Họ và tên khách hàng" styleClass="info-label"/>
                            <TextField fx:id="customerNameField"
                                       promptText="Nhập tên khách hàng (hoặc Khách vãng lai)..."
                                       prefHeight="32.0"
                                       styleClass="customer-input-field"/>
                        </VBox>

                        <VBox spacing="2.0" GridPane.columnIndex="2" GridPane.rowIndex="1">
                            <Label text="Số điện thoại" styleClass="info-label"/>
                            <TextField fx:id="customerPhoneField"
                                       promptText="Nhập SĐT khách..."
                                       prefHeight="32.0"
                                       styleClass="customer-input-field"/>
                        </VBox>
                    </GridPane>

                    <!-- ORDER DETAIL TABLE (Món đã gọi của bàn) -->
                    <VBox spacing="4.0" prefHeight="165.0" minHeight="130.0" maxHeight="190.0">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Danh sách món gọi của bàn" styleClass="section-subtitle-bold"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="cartItemCountLabel" text="0 món" styleClass="section-subtitle"/>
                        </HBox>

                        <TableView fx:id="orderDetailTable"
                                   VBox.vgrow="ALWAYS"
                                   styleClass="order-detail-table">
                            <columns>
                                <TableColumn fx:id="detailIndexColumn"
                                             text="STT"
                                             prefWidth="45.0"
                                             style="-fx-alignment: CENTER;"/>

                                <TableColumn fx:id="productNameColumn"
                                             text="Tên món"
                                             prefWidth="220.0"/>

                                <TableColumn fx:id="quantityColumn"
                                             text="SL"
                                             prefWidth="85.0"
                                             style="-fx-alignment: CENTER;"/>

                                <TableColumn fx:id="unitPriceColumn"
                                             text="Đơn giá"
                                             prefWidth="110.0"
                                             style="-fx-alignment: CENTER-RIGHT;"/>

                                <TableColumn fx:id="subtotalColumn"
                                             text="Thành tiền"
                                             prefWidth="120.0"
                                             style="-fx-alignment: CENTER-RIGHT;"/>
                            </columns>

                            <placeholder>
                                <Label text="Chưa có món nào. Chọn sản phẩm bên dưới để thêm vào bàn này." styleClass="empty-label"/>
                            </placeholder>
                        </TableView>
                    </VBox>

                    <!-- DANH MỤC & SẢN PHẨM TỪ DB -->
                    <VBox spacing="6.0" VBox.vgrow="ALWAYS">
                        <!-- HEADER THỰC ĐƠN & TÌM KIẾM -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label text="Thực đơn món" styleClass="section-subtitle-bold"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <TextField fx:id="productSearchField"
                                       promptText="Tìm kiếm món theo tên..."
                                       prefWidth="220.0"
                                       prefHeight="32.0"
                                       styleClass="search-field"/>
                        </HBox>

                        <!-- DANH MỤC CHIPS -->
                        <ScrollPane fitToHeight="true"
                                    vbarPolicy="NEVER"
                                    hbarPolicy="AS_NEEDED"
                                    styleClass="category-bar-scroll"
                                    prefHeight="36.0"
                                    minHeight="36.0">
                            <HBox fx:id="categoryTabBox"
                                  spacing="8.0"
                                  alignment="CENTER_LEFT"/>
                        </ScrollPane>

                        <!-- LƯỚI SẢN PHẨM -->
                        <ScrollPane fitToWidth="true"
                                    hbarPolicy="NEVER"
                                    vbarPolicy="AS_NEEDED"
                                    styleClass="product-scroll-pane"
                                    prefHeight="150.0"
                                    minHeight="120.0"
                                    VBox.vgrow="ALWAYS">
                            <FlowPane fx:id="productCatalogFlow"
                                      hgap="10.0"
                                      vgap="10.0"/>
                        </ScrollPane>
                    </VBox>

                    <!-- TOTAL CARD -->
                    <HBox alignment="CENTER_LEFT"
                          styleClass="total-card">
                        <padding>
                            <Insets top="10.0" right="16.0" bottom="10.0" left="16.0"/>
                        </padding>

                        <VBox spacing="2.0">
                            <Label text="TỔNG TIỀN THANH TOÁN" styleClass="total-label"/>
                            <Label text="Đã bao gồm VAT &amp; phí dịch vụ" styleClass="total-subtext"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label fx:id="totalAmountLabel"
                               text="0 đ"
                               styleClass="total-value"/>
                    </HBox>

                    <!-- ACTION BUTTONS -->
                    <HBox spacing="10.0" prefHeight="40.0">
                        <Button fx:id="printOrderButton"
                                text="▣  In hóa đơn"
                                prefHeight="40.0"
                                maxWidth="1.7976931348623157E308"
                                HBox.hgrow="ALWAYS"
                                onAction="#handlePrintInvoice"
                                styleClass="secondary-button"/>

                        <Button fx:id="editOrderButton"
                                text="✎  Chọn KH"
                                prefHeight="40.0"
                                maxWidth="1.7976931348623157E308"
                                HBox.hgrow="ALWAYS"
                                onAction="#handleEditOrder"
                                styleClass="secondary-button"/>

                        <Button fx:id="paymentButton"
                                text="✓  Thanh toán"
                                prefHeight="40.0"
                                maxWidth="1.7976931348623157E308"
                                HBox.hgrow="ALWAYS"
                                onAction="#handlePayment"
                                styleClass="primary-button,action-pay-button"/>
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </center>

</BorderPane>