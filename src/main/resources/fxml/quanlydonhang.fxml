<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>


<BorderPane fx:id="quanLyDonHangRoot"
            maxHeight="1000"
            maxWidth="1600"
            prefHeight="1000"
            prefWidth="1600"
            stylesheets="@../css/quanlydonhang.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.AdminController">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="270.0"
              maxWidth="270.0"
              styleClass="sidebar">

            <VBox alignment="CENTER" prefHeight="150.0">
                <ImageView fitHeight="100.0" fitWidth="180.0" preserveRatio="true">
                    <image>
                        <Image url="@../images/LunaveraLogo.png"/>
                    </image>
                </ImageView>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <VBox spacing="6.0" VBox.vgrow="NEVER">
                <Button text="⌂   Trang chủ"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openDashboard"/>

                <Button text="▣   Quản lý sản phẩm"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openProductManagement"/>

                <Button text="▤   Quản lý đơn hàng"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button,menu-button-active"/>

                <Button text="♙   Quản lý khách hàng"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openCustomerManagement"/>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <VBox spacing="6.0">
                <Button text="▦   Quản lý danh mục"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openCategoryManagement"/>

                <Button text="▣   Quản lý kho"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openInventoryManagement"/>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <VBox spacing="6.0">
                <Button text="♙   Quản lý nhân viên"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openEmployeeManagement"/>

                <Button text="♙   Quản lý tài khoản"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openAccountManagement"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox alignment="CENTER_LEFT" spacing="8.0">
                <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                </padding>
                <Button text="←   Đăng xuất"
                        prefHeight="42.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="logout-button"
                        onAction="#logout"/>

                <Label text="Cà phê ngon&#10;Ngày thêm tốt đẹp"
                       styleClass="sidebar-footer"/>
            </VBox>
        </VBox>
    </left>

    <!-- ================= MAIN CONTENT ================= -->
    <center>
        <VBox styleClass="content">

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT"
                  spacing="10"
                  prefHeight="72"
                  styleClass="page-header">

                <VBox HBox.hgrow="ALWAYS" spacing="3">
                    <Label text="Quản lý đơn hàng"
                           styleClass="page-title"/>
                    <Label text="Theo dõi và quản lý các đơn hàng của cửa hàng"
                           styleClass="page-description"/>
                </VBox>

                <Label text="♧" styleClass="header-icon"/>

                <VBox alignment="CENTER_RIGHT" spacing="2">
                    <Label fx:id="adminNameLabel"
                           text="Admin"
                           styleClass="admin-name"/>
                    <Label fx:id="adminRoleLabel"
                           text="Quản trị viên"
                           styleClass="admin-role"/>
                </VBox>

                <Label text="◎" styleClass="profile-icon"/>
            </HBox>

            <!-- ================= ORDER STATUS ================= -->
            <HBox spacing="8" styleClass="order-status-tabs">

                <Button fx:id="allOrderButton"
                        text="Tất cả"
                        styleClass="order-status-button,order-status-button-active"
                        onAction="#handleAllOrders"/>

                <Button fx:id="openOrderButton"
                        text="Đang xử lý"
                        styleClass="order-status-button"
                        onAction="#handleOpenOrders"/>

                <Button fx:id="paidOrderButton"
                        text="Đã thanh toán"
                        styleClass="order-status-button"
                        onAction="#handlePaidOrders"/>

                <Button fx:id="cancelledOrderButton"
                        text="Đã hủy"
                        styleClass="order-status-button"
                        onAction="#handleCancelledOrders"/>
            </HBox>

            <!-- ================= FILTER ================= -->
            <HBox spacing="8" styleClass="filter-bar">

                <TextField fx:id="searchOrderField"
                           promptText="Tìm theo mã đơn hoặc khách hàng..."
                           HBox.hgrow="ALWAYS"
                           styleClass="search-field"
                           onKeyReleased="#handleSearchOrder"/>

                <ComboBox fx:id="orderStatusFilter"
                          prefWidth="145"
                          promptText="Trạng thái đơn"
                          styleClass="filter-combo"
                          onAction="#handleOrderStatusFilter"/>

                <DatePicker fx:id="orderDateFilter"
                            prefWidth="145"
                            promptText="Ngày đặt"
                            styleClass="filter-date"
                            onAction="#handleOrderDateFilter"/>

                <Button fx:id="clearOrderFilterButton"
                        text="Xóa lọc"
                        styleClass="secondary-button"
                        onAction="#handleClearOrderFilter"/>

                <Button fx:id="refreshOrderButton"
                        text="↻"
                        styleClass="secondary-button"
                        onAction="#handleRefreshOrders"/>
            </HBox>

            <!-- ================= ORDER TABLE ================= -->
            <VBox VBox.vgrow="ALWAYS"
                  spacing="10"
                  styleClass="table-card">

                <TableView fx:id="orderTable"
                           VBox.vgrow="ALWAYS"
                           styleClass="order-table">

                    <columns>

                        <!-- Order.order_id -->
                        <TableColumn fx:id="orderIdColumn"
                                     text="Mã đơn"
                                     prefWidth="85"/>

                        <!-- Order.customer_id -> Customer -->
                        <TableColumn fx:id="customerColumn"
                                     text="Khách hàng"
                                     prefWidth="170"/>

                        <!-- Table.table_id / table_number -->
                        <TableColumn fx:id="tableColumn"
                                     text="Bàn"
                                     prefWidth="80"/>

                        <!-- Order.user_id -> User -->
                        <TableColumn fx:id="employeeColumn"
                                     text="Nhân viên"
                                     prefWidth="150"/>

                        <!-- Order.order_time -->
                        <TableColumn fx:id="orderTimeColumn"
                                     text="Thời gian"
                                     prefWidth="155"/>

                        <!-- Order.status -->
                        <TableColumn fx:id="statusColumn"
                                     text="Trạng thái"
                                     prefWidth="130"/>

                        <!-- Order.total_amount -->
                        <TableColumn fx:id="totalAmountColumn"
                                     text="Tổng tiền"
                                     prefWidth="130"/>

                        <!-- UI action -->
                        <TableColumn fx:id="actionColumn"
                                     text="Thao tác"
                                     prefWidth="150"/>
                    </columns>

                    <placeholder>
                        <Label text="Chưa có đơn hàng"
                               styleClass="empty-label"/>
                    </placeholder>
                </TableView>

                <!-- FOOTER -->
                <HBox alignment="CENTER_LEFT" spacing="5">

                    <Label fx:id="totalOrderLabel"
                           text="Tổng cộng: 0 đơn hàng"
                           styleClass="table-footer"/>

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button fx:id="previousOrderPageButton"
                            text="‹"
                            styleClass="page-button"
                            onAction="#handlePreviousOrderPage"/>

                    <Button fx:id="orderPageOneButton"
                            text="1"
                            styleClass="page-button,page-button-active"
                            onAction="#handleOrderPageOne"/>

                    <Button fx:id="orderPageTwoButton"
                            text="2"
                            styleClass="page-button"
                            onAction="#handleOrderPageTwo"/>

                    <Button fx:id="nextOrderPageButton"
                            text="›"
                            styleClass="page-button"
                            onAction="#handleNextOrderPage"/>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>