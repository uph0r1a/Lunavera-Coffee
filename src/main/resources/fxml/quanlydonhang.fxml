<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="quanLyDonHangRoot"
            prefWidth="1600.0"
            prefHeight="1000.0"
            minWidth="1600.0"
            minHeight="1000.0"
            maxWidth="1600.0"
            maxHeight="1000.0"
            styleClass="dashboard"
            stylesheets="@../css/quanlydonhang.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.AdminController">

    <!-- ========================================================= -->
    <!-- SIDEBAR -->
    <!-- ========================================================= -->
    <left>
        <VBox prefWidth="270.0"
              maxWidth="270.0"
              styleClass="sidebar">

            <!-- LOGO -->
            <VBox alignment="CENTER" prefHeight="150.0">
                <ImageView fitHeight="100.0" fitWidth="180.0" preserveRatio="true">
                    <image>
                        <Image url="@../images/background/LunaveraLogo.png"/>
                    </image>
                </ImageView>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <!-- MENU 1 -->
            <VBox spacing="6.0" VBox.vgrow="NEVER">
                <Button text="⌂   Trang chủ"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openDashboard"/>

                <Button text="▣   Quản lý sản phẩm"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openProductManagement"/>

                <Button text="▤   Quản lý đơn hàng"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button,menu-button-active"/>

                <Button text="♙   Quản lý khách hàng"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openCustomerManagement"/>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <!-- MENU 2 -->
            <VBox spacing="6.0">
                <Button text="▦   Quản lý danh mục"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openCategoryManagement"/>

                <Button text="▣   Quản lý kho"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openInventoryManagement"/>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <!-- MENU 3 -->
            <VBox spacing="6.0">
                <Button text="♙   Quản lý nhân viên"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openEmployeeManagement"/>

                <Button text="♙   Quản lý tài khoản"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openAccountManagement"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- LOGOUT -->
            <VBox alignment="CENTER_LEFT" spacing="8.0">
                <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                </padding>

                <Button text="←   Đăng xuất"
                        prefHeight="42.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="logout-button"
                        onAction="#logout"/>

                <Label text="Cà phê ngon&#10;Ngày thêm tốt đẹp"
                       styleClass="sidebar-footer"/>
            </VBox>
        </VBox>
    </left>


    <!-- ========================================================= -->
    <!-- MAIN CONTENT -->
    <!-- ========================================================= -->
    <center>
        <VBox spacing="16.0" styleClass="content">
            <padding>
                <Insets top="20.0" right="24.0" bottom="20.0" left="24.0"/>
            </padding>

            <!-- ================= HEADER ================= -->
            <HBox alignment="CENTER_LEFT"
                  spacing="12.0"
                  prefHeight="68.0"
                  styleClass="page-header">

                <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                    <Label text="Quản lý đơn hàng" styleClass="page-title"/>
                    <Label text="Sơ đồ bàn, tạo đơn phục vụ và quản lý hóa đơn thanh toán"
                           styleClass="page-description"/>
                </VBox>

                <Label text="♧" styleClass="header-icon"/>

                <VBox alignment="CENTER_RIGHT" spacing="2.0">
                    <Label fx:id="adminNameLabel" text="Admin" styleClass="admin-name"/>
                    <Label fx:id="adminRoleLabel" text="Quản trị viên" styleClass="admin-role"/>
                </VBox>

                <Label text="◎" styleClass="profile-icon"/>
            </HBox>


            <!-- ================= MAIN LAYOUT ================= -->
            <HBox spacing="18.0" VBox.vgrow="ALWAYS">

                <!-- ================= LEFT: SƠ ĐỒ BÀN ================= -->
                <VBox prefWidth="500.0"
                      minWidth="480.0"
                      maxWidth="520.0"
                      spacing="14.0"
                      styleClass="content-card">
                    <padding>
                        <Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/>
                    </padding>

                    <!-- TABLE HEADER -->
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <Label text="Sơ đồ bàn phục vụ" styleClass="section-title"/>
                            <Label text="Chọn bàn để tạo hoặc xem đơn"
                                   styleClass="section-subtitle"/>
                        </VBox>

                        <!-- STATUS LEGENDS -->
                        <HBox spacing="12.0" alignment="CENTER">
                            <HBox spacing="5.0" alignment="CENTER">
                                <Label text="●" styleClass="status-dot-occupied"/>
                                <Label text="Đang có đơn" styleClass="status-legend-text"/>
                            </HBox>

                            <HBox spacing="5.0" alignment="CENTER">
                                <Label text="●" styleClass="status-dot-empty"/>
                                <Label text="Còn trống" styleClass="status-legend-text"/>
                            </HBox>
                        </HBox>
                    </HBox>

                    <!-- TABLE GRID (3x4 = 12 BÀN) -->
                    <GridPane fx:id="tableGrid"
                              hgap="12.0"
                              vgap="12.0"
                              VBox.vgrow="ALWAYS">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="33.333" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="33.333" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="33.333" hgrow="ALWAYS"/>
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints percentHeight="25.0" vgrow="ALWAYS"/>
                            <RowConstraints percentHeight="25.0" vgrow="ALWAYS"/>
                            <RowConstraints percentHeight="25.0" vgrow="ALWAYS"/>
                            <RowConstraints percentHeight="25.0" vgrow="ALWAYS"/>
                        </rowConstraints>

                        <!-- ROW 1 -->
                        <Button fx:id="table1Button"
                                text="☕  Bàn 1&#10;Đang có đơn"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="0"
                                maxWidth="1.7976931348623157E308"
                                maxHeight="1.7976931348623157E308"
                                styleClass="table-button-occupied"/>

                        <Button fx:id="table2Button"
                                text="☕  Bàn 2&#10;Còn trống"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="0"
                                maxWidth="1.7976931348623157E308"
                                maxHeight="1.7976931348623157E308"
                                styleClass="table-button-empty,table-button-selected"/>

                        <Button fx:id="table3Button"
                                text="☕  Bàn 3&#10;Đang có đơn"
                                GridPane.columnIndex="2"
                                GridPane.rowIndex="0"
                                maxWidth="1.7976931348623157E308"
                                maxHeight="1.7976931348623157E308"
                                styleClass="table-button-occupied"/>

                        <!-- ROW 2 -->
                        <Button fx:id="table4Button"
                                text="☕  Bàn 4&#10;Còn trống"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="1"
                                maxWidth="1.7976931348623157E308"
                                maxHeight="1.7976931348623157E308"
                                styleClass="table-button-empty"/>

                        <Button fx:id="table5Button"
                                text="☕  Bàn 5&#10;Còn trống"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="1"
                                maxWidth="1.7976931348623157E308"
                                maxHeight="1.7976931348623157E308"
                                styleClass="table-button-empty"/>

                        <Button fx:id="table6Button"
                                text="☕  Bàn 6&#10;Đang có đơn"
                                GridPane.columnIndex="2"
                                GridPane.rowIndex="1"
                                maxWidth="1.7976931348623157E308"
                                maxHeight="1.7976931348623157E308"
                                styleClass="table-button-occupied"/>

                        <!-- ROW 3 -->
                        <Button fx:id="table7Button"
                                text="☕  Bàn 7&#10;Còn trống"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="2"
                                maxWidth="1.7976931348623157E308"
                                maxHeight="1.7976931348623157E308"
                                styleClass="table-button-empty"/>

                        <Button fx:id="table8Button"
                                text="☕  Bàn 8&#10;Đang có đơn"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="2"
                                maxWidth="1.7976931348623157E308"
                                maxHeight="1.7976931348623157E308"
                                styleClass="table-button-occupied"/>

                        <Button fx:id="table9Button"
                                text="☕  Bàn 9&#10;Còn trống"
                                GridPane.columnIndex="2"
                                GridPane.rowIndex="2"
                                maxWidth="1.7976931348623157E308"
                                maxHeight="1.7976931348623157E308"
                                styleClass="table-button-empty"/>

                        <!-- ROW 4 -->
                        <Button fx:id="table10Button"
                                text="☕  Bàn 10&#10;Còn trống"
                                GridPane.columnIndex="0"
                                GridPane.rowIndex="3"
                                maxWidth="1.7976931348623157E308"
                                maxHeight="1.7976931348623157E308"
                                styleClass="table-button-empty"/>

                        <Button fx:id="table11Button"
                                text="☕  Bàn 11&#10;Đang có đơn"
                                GridPane.columnIndex="1"
                                GridPane.rowIndex="3"
                                maxWidth="1.7976931348623157E308"
                                maxHeight="1.7976931348623157E308"
                                styleClass="table-button-occupied"/>

                        <Button fx:id="table12Button"
                                text="☕  Bàn 12&#10;Còn trống"
                                GridPane.columnIndex="2"
                                GridPane.rowIndex="3"
                                maxWidth="1.7976931348623157E308"
                                maxHeight="1.7976931348623157E308"
                                styleClass="table-button-empty"/>
                    </GridPane>

                    <!-- SELECTED TABLE ACTION BAR -->
                    <HBox alignment="CENTER_LEFT"
                          spacing="12.0"
                          styleClass="selected-table">
                        <padding>
                            <Insets top="10.0" right="14.0" bottom="10.0" left="14.0"/>
                        </padding>

                        <VBox spacing="3.0" HBox.hgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT" spacing="8.0">
                                <Label fx:id="selectedTableLabel"
                                       text="Bàn 2"
                                       styleClass="selected-table-title"/>
                                <Label fx:id="selectedTableStatusLabel"
                                       text="Đang trống"
                                       styleClass="empty-badge"/>
                            </HBox>
                            <Label fx:id="selectedTableCapacityLabel"
                                   text="Sức chứa: 4 người • Tầng 1"
                                   styleClass="selected-table-info"/>
                        </VBox>

                        <HBox spacing="8.0" alignment="CENTER_RIGHT">
                            <Button fx:id="startOrderButton"
                                    text="▶  Đặt đơn"
                                    prefHeight="36.0"
                                    styleClass="primary-button"/>

                            <Button fx:id="tableDetailButton"
                                    text="Xem chi tiết"
                                    prefHeight="36.0"
                                    styleClass="secondary-button"/>
                        </HBox>
                    </HBox>
                </VBox>


                <!-- ================= RIGHT: ĐƠN HÀNG HIỆN TẠI (MỞ RỘNG) ================= -->
                <VBox prefWidth="764.0"
                      spacing="14.0"
                      HBox.hgrow="ALWAYS"
                      styleClass="content-card">
                    <padding>
                        <Insets top="18.0" right="22.0" bottom="18.0" left="22.0"/>
                    </padding>

                    <!-- ORDER HEADER -->
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                            <Label text="Đơn hàng hiện tại" styleClass="section-title"/>
                            <Label text="Thông tin chi tiết đơn hàng của bàn đang chọn"
                                   styleClass="section-subtitle"/>
                        </VBox>

                        <Label fx:id="orderStatusLabel"
                               text="Đang phục vụ"
                               styleClass="order-status-badge"/>
                    </HBox>

                    <!-- ORDER INFO METRICS -->
                    <GridPane hgap="20.0"
                              vgap="10.0"
                              styleClass="order-info-card">
                        <padding>
                            <Insets top="12.0" right="16.0" bottom="12.0" left="16.0"/>
                        </padding>
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS"/>
                            <ColumnConstraints percentWidth="50.0" hgrow="ALWAYS"/>
                        </columnConstraints>

                        <!-- Cell 1: Mã đơn -->
                        <VBox spacing="2.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <Label text="Mã đơn hàng" styleClass="info-label"/>
                            <Label fx:id="orderIdLabel" text="#DH000124" styleClass="info-value"/>
                        </VBox>

                        <!-- Cell 2: Khách hàng -->
                        <VBox spacing="2.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label text="Khách hàng" styleClass="info-label"/>
                            <Label fx:id="customerLabel" text="Khách vãng lai" styleClass="info-value"/>
                        </VBox>

                        <!-- Cell 3: Bàn -->
                        <VBox spacing="2.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label text="Vị trí phục vụ" styleClass="info-label"/>
                            <Label fx:id="orderTableLabel" text="Bàn 2 (Tầng 1)" styleClass="info-value"/>
                        </VBox>

                        <!-- Cell 4: Giờ tạo -->
                        <VBox spacing="2.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label text="Thời gian tạo đơn" styleClass="info-label"/>
                            <Label fx:id="orderTimeLabel" text="23/09/2026 17:08" styleClass="info-value"/>
                        </VBox>
                    </GridPane>

                    <!-- ORDER DETAIL TABLE -->
                    <VBox spacing="6.0" VBox.vgrow="ALWAYS">
                        <Label text="Danh sách món gọi" styleClass="section-subtitle-bold"/>

                        <TableView fx:id="orderDetailTable"
                                   prefHeight="290.0"
                                   VBox.vgrow="ALWAYS"
                                   styleClass="order-detail-table">
                            <columns>
                                <TableColumn fx:id="detailIndexColumn"
                                             text="STT"
                                             prefWidth="55.0"
                                             style="-fx-alignment: CENTER;"/>

                                <TableColumn fx:id="productNameColumn"
                                             text="Tên món"
                                             prefWidth="280.0"/>

                                <TableColumn fx:id="quantityColumn"
                                             text="SL"
                                             prefWidth="70.0"
                                             style="-fx-alignment: CENTER;"/>

                                <TableColumn fx:id="unitPriceColumn"
                                             text="Đơn giá"
                                             prefWidth="145.0"
                                             style="-fx-alignment: CENTER-RIGHT;"/>

                                <TableColumn fx:id="subtotalColumn"
                                             text="Thành tiền"
                                             prefWidth="160.0"
                                             style="-fx-alignment: CENTER-RIGHT;"/>
                            </columns>

                            <placeholder>
                                <Label text="Chưa có món nào trong đơn hàng" styleClass="empty-label"/>
                            </placeholder>
                        </TableView>
                    </VBox>

                    <!-- ADD PRODUCT QUICK BAR -->
                    <HBox spacing="10.0" alignment="CENTER_LEFT">
                        <TextField fx:id="productSearchField"
                                   promptText="Tìm món nhanh (tên hoặc mã sản phẩm)..."
                                   prefHeight="38.0"
                                   HBox.hgrow="ALWAYS"
                                   styleClass="search-field"/>

                        <Button fx:id="addProductButton"
                                text="⊕  Thêm món"
                                prefHeight="38.0"
                                styleClass="primary-button"/>
                    </HBox>

                    <!-- TOTAL CARD -->
                    <HBox alignment="CENTER_LEFT"
                          styleClass="total-card">
                        <padding>
                            <Insets top="12.0" right="16.0" bottom="12.0" left="16.0"/>
                        </padding>

                        <VBox spacing="2.0">
                            <Label text="TỔNG TIỀN THANH TOÁN" styleClass="total-label"/>
                            <Label text="Đã bao gồm VAT &amp; phí dịch vụ" styleClass="total-subtext"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label fx:id="totalAmountLabel"
                               text="215.000 đ"
                               styleClass="total-value"/>
                    </HBox>

                    <!-- ACTION BUTTONS -->
                    <HBox spacing="10.0" prefHeight="42.0">
                        <Button fx:id="printOrderButton"
                                text="▣  In hóa đơn"
                                prefHeight="42.0"
                                maxWidth="1.7976931348623157E308"
                                HBox.hgrow="ALWAYS"
                                styleClass="secondary-button"/>

                        <Button fx:id="editOrderButton"
                                text="✎  Chỉnh sửa"
                                prefHeight="42.0"
                                maxWidth="1.7976931348623157E308"
                                HBox.hgrow="ALWAYS"
                                styleClass="secondary-button"/>

                        <Button fx:id="paymentButton"
                                text="✓  Thanh toán"
                                prefHeight="42.0"
                                maxWidth="1.7976931348623157E308"
                                HBox.hgrow="ALWAYS"
                                styleClass="primary-button,action-pay-button"/>
                    </HBox>
                </VBox>
            </HBox>
        </VBox>
    </center>

</BorderPane>