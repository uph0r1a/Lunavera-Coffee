<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane fx:id="quanLyKhachHangRoot"
            prefWidth="1600.0"
            prefHeight="1000.0"
            minWidth="1600.0"
            minHeight="1000.0"
            maxWidth="1600.0"
            maxHeight="1000.0"
            stylesheets="@../css/admin-trangchu.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.AdminController"
            styleClass="dashboard">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="270.0"
              maxWidth="270.0"
              styleClass="sidebar">

            <VBox alignment="CENTER" prefHeight="150.0">
                <ImageView fitHeight="100.0" fitWidth="180.0" preserveRatio="true">
                    <image>
                        <Image url="@../images/LunaveraLogo.png"/>
                    </image>
                </ImageView>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <VBox spacing="6.0" VBox.vgrow="NEVER">
                <Button text="⌂   Trang chủ"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openDashboard"/>

                <Button text="▣   Quản lý sản phẩm"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openProductManagement"/>

                <Button text="▤   Quản lý đơn hàng"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openOrderManagement"/>

                <Button text="♙   Quản lý khách hàng"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button,menu-button-active"/>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <VBox spacing="6.0">
                <Button text="▦   Quản lý danh mục"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openCategoryManagement"/>

                <Button text="▣   Quản lý kho"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openInventoryManagement"/>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <VBox spacing="6.0">
                <Button text="♙   Quản lý nhân viên"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openEmployeeManagement"/>

                <Button text="♙   Quản lý tài khoản"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openAccountManagement"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox alignment="CENTER_LEFT" spacing="8.0">
                <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                </padding>
                <Button text="←   Đăng xuất"
                        prefHeight="42.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="logout-button"
                        onAction="#logout"/>

                <Label text="Cà phê ngon&#10;Ngày thêm tốt đẹp"
                       styleClass="sidebar-footer"/>
            </VBox>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="20.0" styleClass="content">

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT" prefHeight="70.0">
                <VBox spacing="4.0">
                    <Label text="Quản lý khách hàng" styleClass="page-title"/>
                    <Label text="Danh sách và thông tin chi tiết khách hàng thành viên"
                           styleClass="page-subtitle"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <VBox alignment="CENTER_RIGHT" spacing="3.0">
                    <Label text="Admin" styleClass="account-name"/>
                    <Label text="Quản trị viên" styleClass="account-role"/>
                </VBox>
            </HBox>

            <!-- SEARCH AND ACTIONS -->
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <TextField promptText="Tìm kiếm khách hàng theo tên, số điện thoại..."
                           prefHeight="42.0"
                           prefWidth="400.0"
                           styleClass="search-field"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="+   Thêm khách hàng"
                        prefHeight="42.0"
                        styleClass="primary-button"/>
            </HBox>

            <!-- CUSTOMER TABLE -->
            <VBox VBox.vgrow="ALWAYS" styleClass="content-card">
                <TableView VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn prefWidth="70.0" text="STT"/>
                        <TableColumn prefWidth="250.0" text="Họ và tên"/>
                        <TableColumn prefWidth="180.0" text="Số điện thoại"/>
                        <TableColumn prefWidth="250.0" text="Email"/>
                        <TableColumn prefWidth="180.0" text="Điểm tích lũy"/>
                        <TableColumn prefWidth="180.0" text="Hạng thành viên"/>
                        <TableColumn prefWidth="160.0" text="Thao tác"/>
                    </columns>
                    <placeholder>
                        <Label text="Chưa có thông tin khách hàng"/>
                    </placeholder>
                </TableView>
            </VBox>

        </VBox>
    </center>

</BorderPane>
