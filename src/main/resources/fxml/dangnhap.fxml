<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="adminRoot"
            stylesheets="@../css/admin-trangchu.css"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.AdminController">

   <left>
      <VBox fx:id="sidebar"
            minWidth="270"
            prefWidth="270"
            maxWidth="270"
            styleClass="sidebar">

         <VBox alignment="CENTER"
               spacing="4"
               styleClass="logo-section">

            <ImageView fx:id="logoImage"
                       fitHeight="105"
                       fitWidth="170"
                       preserveRatio="true">
               <image>
                  <Image url="@../images/LunaveraLogo.png"/>
               </image>
            </ImageView>

         </VBox>

         <VBox fx:id="menuContainer"
               spacing="8"
               styleClass="menu-container">

            <Button fx:id="homeButton"
                    maxWidth="1.7976931348623157E308"
                    mnemonicParsing="false"
                    styleClass="menu-button menu-button-active"
                    text="⌂   Trang chủ"/>

            <Button fx:id="productButton"
                    maxWidth="1.7976931348623157E308"
                    mnemonicParsing="false"
                    styleClass="menu-button"
                    text="▣   Quản lý sản phẩm"/>

            <Button fx:id="orderButton"
                    maxWidth="1.7976931348623157E308"
                    mnemonicParsing="false"
                    styleClass="menu-button"
                    text="🛒   Quản lý đơn hàng"/>

            <Button fx:id="accountButton"
                    maxWidth="1.7976931348623157E308"
                    mnemonicParsing="false"
                    styleClass="menu-button"
                    text="♙   Quản lý tài khoản"/>

            <Button fx:id="categoryButton"
                    maxWidth="1.7976931348623157E308"
                    mnemonicParsing="false"
                    styleClass="menu-button"
                    text="▦   Quản lý danh mục"/>

            <Button fx:id="reviewButton"
                    maxWidth="1.7976931348623157E308"
                    mnemonicParsing="false"
                    styleClass="menu-button"
                    text="☆   Quản lý đánh giá"/>

            <Button fx:id="blogButton"
                    maxWidth="1.7976931348623157E308"
                    mnemonicParsing="false"
                    styleClass="menu-button"
                    text="▤   Tin tức &amp; Blog"/>

         </VBox>

         <Region VBox.vgrow="ALWAYS"/>

         <VBox spacing="8"
               styleClass="sidebar-bottom">

            <Button fx:id="logoutButton"
                    maxWidth="1.7976931348623157E308"
                    mnemonicParsing="false"
                    styleClass="logout-button"
                    text="←   Đăng xuất"/>

            <Label styleClass="coffee-slogan"
                   text="Good Coffee&#10;Better Days"
                   textAlignment="CENTER"/>

         </VBox>

      </VBox>
   </left>

   <center>
      <BorderPane fx:id="contentRoot">

         <top>
            <HBox fx:id="topBar"
                  alignment="CENTER_LEFT"
                  prefHeight="78"
                  spacing="15"
                  styleClass="top-bar">

               <VBox spacing="3">
                  <Label fx:id="welcomeLabel"
                         styleClass="welcome-title"
                         text="Chào mừng, Admin!"/>

                  <Label fx:id="welcomeDescription"
                         styleClass="welcome-description"
                         text="Chúc bạn có một ngày làm việc hiệu quả!"/>
               </VBox>

               <Region HBox.hgrow="ALWAYS"/>

               <Button fx:id="notificationButton"
                       mnemonicParsing="false"
                       styleClass="icon-button"
                       text="♧"/>

               <VBox alignment="CENTER_RIGHT"
                     spacing="2">

                  <Label fx:id="adminNameLabel"
                         styleClass="admin-name"
                         text="Admin"/>

                  <Label fx:id="adminRoleLabel"
                         styleClass="admin-role"
                         text="Quản trị viên"/>

               </VBox>

               <Button fx:id="profileMenuButton"
                       mnemonicParsing="false"
                       styleClass="profile-arrow"
                       text="⌄"/>

            </HBox>
         </top>

         <center>
            <ScrollPane fx:id="dashboardScrollPane"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED"
                        styleClass="dashboard-scroll">

               <content>
                  <VBox fx:id="dashboardContent"
                        spacing="18"
                        styleClass="dashboard-content">

                     <padding>
                        <Insets top="20"
                                right="25"
                                bottom="25"
                                left="25"/>
                     </padding>

                     <GridPane fx:id="statisticsGrid"
                               hgap="16"
                               vgap="16">

                        <columnConstraints>
                           <ColumnConstraints hgrow="ALWAYS"/>
                           <ColumnConstraints hgrow="ALWAYS"/>
                           <ColumnConstraints hgrow="ALWAYS"/>
                           <ColumnConstraints hgrow="ALWAYS"/>
                        </columnConstraints>

                        <VBox GridPane.columnIndex="0"
                              prefHeight="140"
                              styleClass="stat-card">

                           <Label styleClass="stat-icon"
                                  text="▣"/>

                           <Label styleClass="stat-title"
                                  text="Tổng số bàn"/>

                           <Label fx:id="totalTablesLabel"
                                  styleClass="stat-value"
                                  text="0"/>

                           <HBox spacing="8">

                              <Label styleClass="stat-subtitle"
                                     text="Đã sử dụng:"/>

                              <Label fx:id="usedTablesLabel"
                                     styleClass="stat-subtitle"
                                     text="0"/>

                              <Label styleClass="stat-dot"
                                     text="•"/>

                              <Label styleClass="stat-subtitle"
                                     text="Còn trống:"/>

                              <Label fx:id="emptyTablesLabel"
                                     styleClass="stat-subtitle"
                                     text="0"/>

                           </HBox>
                        </VBox>

                        <VBox GridPane.columnIndex="1"
                              prefHeight="140"
                              styleClass="stat-card">

                           <Label styleClass="stat-icon"
                                  text="▤"/>

                           <Label styleClass="stat-title"
                                  text="Đơn hàng hôm nay"/>

                           <Label fx:id="todayOrdersLabel"
                                  styleClass="stat-value"
                                  text="0"/>

                           <Label styleClass="stat-subtitle"
                                  text="Đơn hàng phát sinh hôm nay"/>

                        </VBox>

                        <VBox GridPane.columnIndex="2"
                              prefHeight="140"
                              styleClass="stat-card stat-card-revenue">

                           <Label styleClass="stat-icon"
                                  text="◎"/>

                           <Label styleClass="stat-title"
                                  text="Doanh thu hôm nay"/>

                           <Label fx:id="todayRevenueLabel"
                                  styleClass="stat-value"
                                  text="0đ"/>

                           <Label styleClass="stat-subtitle"
                                  text="Tổng doanh thu trong ngày"/>

                        </VBox>

                        <VBox GridPane.columnIndex="3"
                              prefHeight="140"
                              styleClass="stat-card">

                           <Label styleClass="stat-icon"
                                  text="♙"/>

                           <Label styleClass="stat-title"
                                  text="Khách hàng hôm nay"/>

                           <Label fx:id="todayCustomersLabel"
                                  styleClass="stat-value"
                                  text="0"/>

                           <Label styleClass="stat-subtitle"
                                  text="Số khách hàng đã phục vụ"/>

                        </VBox>

                     </GridPane>

                     <GridPane fx:id="chartsGrid"
                               hgap="16">

                        <columnConstraints>
                           <ColumnConstraints hgrow="ALWAYS"
                                              percentWidth="68"/>
                           <ColumnConstraints hgrow="ALWAYS"
                                              percentWidth="32"/>
                        </columnConstraints>

                        <VBox GridPane.columnIndex="0"
                              prefHeight="320"
                              styleClass="dashboard-card">

                           <HBox alignment="CENTER_LEFT"
                                 spacing="10">

                              <Label styleClass="section-icon"
                                     text="▣"/>

                              <Label styleClass="section-title"
                                     text="Doanh thu 7 ngày gần đây"/>

                              <Region HBox.hgrow="ALWAYS"/>

                              <Button fx:id="revenueFilterButton"
                                      mnemonicParsing="false"
                                      styleClass="filter-button"
                                      text="7 ngày qua   ⌄"/>

                           </HBox>

                           <LineChart fx:id="revenueChart"
                                      animated="false"
                                      createSymbols="true"
                                      legendVisible="false"
                                      horizontalGridLinesVisible="true"
                                      verticalGridLinesVisible="false"
                                      VBox.vgrow="ALWAYS">

                              <xAxis>
                                 <CategoryAxis/>
                              </xAxis>

                              <yAxis>
                                 <NumberAxis forceZeroInRange="true"/>
                              </yAxis>

                           </LineChart>

                        </VBox>

                        <VBox GridPane.columnIndex="1"
                              prefHeight="320"
                              styleClass="dashboard-card">

                           <HBox alignment="CENTER_LEFT"
                                 spacing="10">

                              <Label styleClass="section-icon"
                                     text="🛒"/>

                              <Label styleClass="section-title"
                                     text="Thống kê đơn hàng"/>

                              <Region HBox.hgrow="ALWAYS"/>

                              <Button fx:id="orderFilterButton"
                                      mnemonicParsing="false"
                                      styleClass="filter-button"
                                      text="Hôm nay   ⌄"/>

                           </HBox>

                           <PieChart fx:id="orderChart"
                                     animated="false"
                                     labelsVisible="false"
                                     legendVisible="false"
                                     VBox.vgrow="ALWAYS"/>

                        </VBox>

                     </GridPane>

                     <GridPane fx:id="tableQuickGrid"
                               hgap="16">

                        <columnConstraints>
                           <ColumnConstraints hgrow="ALWAYS"
                                              percentWidth="70"/>
                           <ColumnConstraints hgrow="ALWAYS"
                                              percentWidth="30"/>
                        </columnConstraints>

                        <VBox GridPane.columnIndex="0"
                              spacing="15"
                              styleClass="dashboard-card">

                           <HBox alignment="CENTER_LEFT">

                              <Label styleClass="section-icon"
                                     text="▣"/>

                              <Label styleClass="section-title"
                                     text="Danh sách bàn"/>

                              <Region HBox.hgrow="ALWAYS"/>

                              <Button fx:id="viewAllTablesButton"
                                      mnemonicParsing="false"
                                      styleClass="text-button"
                                      text="Xem tất cả  →"/>

                           </HBox>

                           <FlowPane fx:id="tableContainer"
                                     hgap="14"
                                     vgap="12"
                                     prefWrapLength="900"/>

                        </VBox>

                        <VBox GridPane.columnIndex="1"
                              spacing="15"
                              styleClass="dashboard-card">

                           <HBox alignment="CENTER_LEFT"
                                 spacing="10">

                              <Label styleClass="section-icon"
                                     text="ϟ"/>

                              <Label styleClass="section-title"
                                     text="Thao tác nhanh"/>

                           </HBox>

                           <GridPane hgap="12"
                                     vgap="12"
                                     VBox.vgrow="ALWAYS">

                              <columnConstraints>
                                 <ColumnConstraints hgrow="ALWAYS"/>
                                 <ColumnConstraints hgrow="ALWAYS"/>
                              </columnConstraints>

                              <Button fx:id="addProductButton"
                                      GridPane.columnIndex="0"
                                      GridPane.rowIndex="0"
                                      maxWidth="1.7976931348623157E308"
                                      maxHeight="1.7976931348623157E308"
                                      mnemonicParsing="false"
                                      styleClass="quick-action-button"
                                      text="▣&#10;Thêm sản phẩm"/>

                              <Button fx:id="viewOrdersButton"
                                      GridPane.columnIndex="1"
                                      GridPane.rowIndex="0"
                                      maxWidth="1.7976931348623157E308"
                                      maxHeight="1.7976931348623157E308"
                                      mnemonicParsing="false"
                                      styleClass="quick-action-button"
                                      text="🛒&#10;Xem đơn hàng"/>

                              <Button fx:id="manageAccountsButton"
                                      GridPane.columnIndex="0"
                                      GridPane.rowIndex="1"
                                      maxWidth="1.7976931348623157E308"
                                      maxHeight="1.7976931348623157E308"
                                      mnemonicParsing="false"
                                      styleClass="quick-action-button"
                                      text="♙&#10;Quản lý tài khoản"/>

                              <Button fx:id="viewReportsButton"
                                      GridPane.columnIndex="1"
                                      GridPane.rowIndex="1"
                                      maxWidth="1.7976931348623157E308"
                                      maxHeight="1.7976931348623157E308"
                                      mnemonicParsing="false"
                                      styleClass="quick-action-button"
                                      text="▥&#10;Xem báo cáo"/>

                           </GridPane>
                        </VBox>

                     </GridPane>

                     <VBox fx:id="recentOrdersSection"
                           spacing="12"
                           styleClass="dashboard-card">

                        <HBox alignment="CENTER_LEFT">

                           <Label styleClass="section-icon"
                                  text="🛒"/>

                           <Label styleClass="section-title"
                                  text="Đơn hàng gần đây"/>

                           <Region HBox.hgrow="ALWAYS"/>

                           <Button fx:id="viewAllOrdersButton"
                                   mnemonicParsing="false"
                                   styleClass="text-button"
                                   text="Xem tất cả  →"/>

                        </HBox>

                        <TableView fx:id="recentOrdersTable"
                                   prefHeight="150"
                                   styleClass="orders-table">

                           <columns>

                              <TableColumn fx:id="orderIdColumn"
                                           prefWidth="120"
                                           text="Mã đơn"/>

                              <TableColumn fx:id="customerColumn"
                                           prefWidth="180"
                                           text="Khách hàng"/>

                              <TableColumn fx:id="productColumn"
                                           prefWidth="300"
                                           text="Sản phẩm"/>

                              <TableColumn fx:id="totalColumn"
                                           prefWidth="150"
                                           text="Tổng tiền"/>

                              <TableColumn fx:id="statusColumn"
                                           prefWidth="150"
                                           text="Trạng thái"/>

                              <TableColumn fx:id="timeColumn"
                                           prefWidth="180"
                                           text="Thời gian"/>

                           </columns>

                        </TableView>

                     </VBox>

                  </VBox>
               </content>
            </ScrollPane>
         </center>

      </BorderPane>
   </center>

</BorderPane>