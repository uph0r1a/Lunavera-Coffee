<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="loginRoot"
           prefHeight="720.0"
           prefWidth="1280.0"
           stylesheets="@../css/dangnhap.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.example.controller.LoginController">

   <!-- Background -->
   <ImageView fx:id="backgroundImage"
              fitHeight="720"
              fitWidth="1280"
              pickOnBounds="true"
              preserveRatio="false">
      <image>
         <Image url="@../images/LoginBackgroung.png"/>
      </image>
   </ImageView>

   <!-- Overlay -->
   <AnchorPane styleClass="login-overlay"/>

   <!-- Login Card: Căn sát phải bằng StackPane.alignment và cách mép phải 100px -->
   <VBox fx:id="loginCard"
         alignment="CENTER"
         maxHeight="620"
         maxWidth="410"
         prefHeight="620"
         prefWidth="410"
         spacing="0"
         styleClass="login-card"
         StackPane.alignment="CENTER_RIGHT">

      <StackPane.margin>
         <Insets right="300.0" />
      </StackPane.margin>

      <padding>
         <Insets bottom="35" left="45" right="45" top="35"/>
      </padding>

      <!-- Logo -->
      <ImageView fx:id="logoImage"
                 fitHeight="80"
                 fitWidth="150"
                 preserveRatio="true">
         <image>
            <Image url="@../images/LunaveraLogo.png"/>
         </image>
      </ImageView>

      <!-- Title -->
      <Label styleClass="login-title" text="ĐĂNG NHẬP">
         <VBox.margin>
            <Insets bottom="8" top="8"/>
         </VBox.margin>
      </Label>

      <!-- Subtitle -->
      <Label alignment="CENTER"
             maxWidth="310"
             styleClass="login-subtitle"
             text="Chào mừng bạn trở lại với Lunavera Coffee"
             wrapText="true">
         <VBox.margin>
            <Insets bottom="20"/>
         </VBox.margin>
      </Label>

      <!-- Username -->
      <VBox maxWidth="310" prefWidth="310" spacing="6">
         <Label styleClass="field-label" text="Tên đăng nhập"/>
         <TextField fx:id="usernameField"
                    maxWidth="310"
                    prefHeight="42"
                    prefWidth="310"
                    promptText="Nhập tên đăng nhập"
                    styleClass="login-field"/>
      </VBox>

      <!-- Password -->
      <VBox maxWidth="310" prefWidth="310" spacing="6">
         <VBox.margin>
            <Insets top="12"/>
         </VBox.margin>
         <Label styleClass="field-label" text="Mật khẩu"/>
         <PasswordField fx:id="passwordField"
                        maxWidth="310"
                        prefHeight="42"
                        prefWidth="310"
                        promptText="Nhập mật khẩu"
                        styleClass="login-field"/>
      </VBox>

      <!-- Forgot password -->
      <HBox alignment="CENTER_RIGHT" maxWidth="310" prefWidth="310">
         <VBox.margin>
            <Insets bottom="17" top="7"/>
         </VBox.margin>
         <Hyperlink fx:id="forgotPasswordLink"
                    styleClass="forgot-password"
                    text="Quên mật khẩu?"/>
      </HBox>

      <!-- Login button -->
      <Button fx:id="loginButton"
              maxWidth="310"
              onAction="#handleLogin"
              prefHeight="45"
              prefWidth="310"
              styleClass="login-button"
              text="ĐĂNG NHẬP"/>

      <!-- Register -->
      <HBox alignment="CENTER" maxWidth="310" prefWidth="310" spacing="5">
         <VBox.margin>
            <Insets top="16"/>
         </VBox.margin>
         <Label styleClass="register-question" text="Bạn chưa có tài khoản?"/>
         <Hyperlink fx:id="registerLink"
                    onAction="#handleRegister"
                    styleClass="register-link"
                    text="Đăng ký ngay"/>
      </HBox>

   </VBox>

</StackPane>