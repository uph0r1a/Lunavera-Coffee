<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="registerRoot" stylesheets="@../css/register.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.RegisterController">

    <ImageView fx:id="backgroundImage" mouseTransparent="true" preserveRatio="false" smooth="true">
        <image>
            <Image url="@../images/LoginBackgroung.png"/>
        </image>
    </ImageView>

    <Region fx:id="backgroundOverlay" mouseTransparent="true" styleClass="background-overlay"/>

    <BorderPane fx:id="mainContent" maxHeight="800" maxWidth="1400">

        <left>
            <VBox fx:id="leftPanel" alignment="CENTER" maxWidth="650" prefWidth="650" spacing="12">
                <padding>
                    <Insets bottom="40" left="40" right="40" top="40"/>
                </padding>
            </VBox>
        </left>

        <right>
            <VBox fx:id="rightPanel" alignment="CENTER" maxWidth="800" prefWidth="800">
                <padding>
                    <Insets top="40" right="80" bottom="40" left="20"/>
                </padding>

                <VBox fx:id="registerCard"
                      alignment="TOP_CENTER"
                      maxWidth="510"
                      maxHeight="700"
                      prefWidth="510"
                      prefHeight="700"
                      spacing="10"
                      translateX="0"
                      styleClass="register-card">

                    <padding>
                        <Insets bottom="28" left="30" right="30" top="25"/>
                    </padding>

                    <Label fx:id="moonIcon"
                           styleClass="moon-icon"
                           text="☾"/>

                    <Label fx:id="registerTitle"
                           styleClass="register-title"
                           text="ĐĂNG KÝ TÀI KHOẢN"/>

                    <Label fx:id="registerSubtitle"
                           styleClass="register-description"
                           text="Trở thành thành viên của Lunavera để tận hưởng những ưu đãi đặc biệt"/>

                    <VBox maxWidth="410" prefWidth="410" spacing="5" styleClass="input-group">
                        <Label styleClass="input-label" text="Họ và tên"/>
                        <TextField fx:id="fullNameField"
                                   prefHeight="44"
                                   prefWidth="410"
                                   promptText="Nhập họ và tên"
                                   styleClass="input-field"/>
                    </VBox>

                    <VBox maxWidth="410" prefWidth="410" spacing="5" styleClass="input-group">
                        <Label styleClass="input-label" text="Tên đăng nhập"/>
                        <TextField fx:id="usernameField"
                                   prefHeight="44"
                                   prefWidth="410"
                                   promptText="Nhập tên đăng nhập"
                                   styleClass="input-field"/>
                    </VBox>

                    <VBox maxWidth="410" prefWidth="410" spacing="5" styleClass="input-group">
                        <Label styleClass="input-label" text="Số điện thoại"/>
                        <TextField fx:id="phoneField"
                                   prefHeight="44"
                                   prefWidth="410"
                                   promptText="Nhập số điện thoại"
                                   styleClass="input-field"/>
                    </VBox>

                    <VBox maxWidth="410" prefWidth="410" spacing="5" styleClass="input-group">
                        <Label styleClass="input-label" text="Mật khẩu"/>

                        <HBox maxWidth="410" prefWidth="410" spacing="5">
                            <PasswordField fx:id="passwordField"
                                           prefHeight="44"
                                           promptText="Nhập mật khẩu"
                                           styleClass="input-field"
                                           HBox.hgrow="ALWAYS"/>

                            <Button fx:id="showPasswordButton"
                                    focusTraversable="false"
                                    prefHeight="44"
                                    prefWidth="40"
                                    styleClass="password-button"
                                    text="◉"/>
                        </HBox>
                    </VBox>

                    <VBox maxWidth="410" prefWidth="410" spacing="5" styleClass="input-group">
                        <Label styleClass="input-label" text="Nhập lại mật khẩu"/>

                        <HBox maxWidth="410" prefWidth="410" spacing="5">
                            <PasswordField fx:id="confirmPasswordField"
                                           prefHeight="44"
                                           promptText="Nhập lại mật khẩu"
                                           styleClass="input-field"
                                           HBox.hgrow="ALWAYS"/>

                            <Button fx:id="showConfirmPasswordButton"
                                    focusTraversable="false"
                                    prefHeight="44"
                                    prefWidth="40"
                                    styleClass="password-button"
                                    text="◉"/>
                        </HBox>
                    </VBox>

                    <Button fx:id="registerButton"
                            defaultButton="true"
                            prefHeight="46"
                            prefWidth="410"
                            styleClass="register-button"
                            text="ĐĂNG KÝ   →"/>

                    <HBox alignment="CENTER"
                          maxWidth="410"
                          prefWidth="410"
                          spacing="12">

                        <Region HBox.hgrow="ALWAYS"
                                styleClass="separator"/>

                        <Label styleClass="separator-star"
                               text="✦"/>

                        <Region HBox.hgrow="ALWAYS"
                                styleClass="separator"/>
                    </HBox>

                    <HBox alignment="CENTER" spacing="5">
                        <Label fx:id="loginText"
                               styleClass="login-text"
                               text="Đã có tài khoản?"/>

                        <Hyperlink fx:id="loginLink"
                                   styleClass="login-link"
                                   text="Đăng nhập ngay"/>
                    </HBox>

                </VBox>
            </VBox>
        </right>
    </BorderPane>
</StackPane>