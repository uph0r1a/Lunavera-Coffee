<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane fx:id="dashboardRoot"
            prefWidth="1600.0"
            prefHeight="1000.0"
            minWidth="1600.0"
            minHeight="1000.0"
            maxWidth="1600.0"
            maxHeight="1000.0"
            stylesheets="@../css/employee-trangchu.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.EmployeeController"
            styleClass="dashboard">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="270.0"
              maxWidth="270.0"
              styleClass="sidebar">

            <VBox alignment="CENTER" prefHeight="150.0">
                <ImageView fitHeight="100.0" fitWidth="180.0" preserveRatio="true">
                    <image>
                        <Image url="@../images/LunaveraLogo.png"/>
                    </image>
                </ImageView>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <VBox spacing="6.0" VBox.vgrow="NEVER">
                <Button text="⌂   Trang chủ"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button,menu-button-active"/>

                <Button text="▣   Quản lý sản phẩm"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openProductManagement"/>

                <Button text="▤   Quản lý đơn hàng"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openOrderManagement"/>

                <Button text="♙   Quản lý khách hàng"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openCustomerManagement"/>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <VBox spacing="6.0">
                <Button text="▦   Quản lý danh mục"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openCategoryManagement"/>

                <Button text="▣   Quản lý kho"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openInventoryManagement"/>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <VBox spacing="6.0">

                <Button text="♙   Quản lý tài khoản"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openAccountManagement"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox alignment="CENTER_LEFT" spacing="8.0">
                <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                </padding>
                <Button text="←   Đăng xuất"
                        prefHeight="42.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="logout-button"
                        onAction="#logout"/>

                <Label text="Cà phê ngon&#10;Ngày thêm tốt đẹp"
                       styleClass="sidebar-footer"/>
            </VBox>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="20.0" styleClass="content">

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT" prefHeight="70.0">
                <VBox spacing="4.0">
                    <Label text="Chào mừng, Employee!" styleClass="page-title"/>
                    <Label text="Chúc bạn có một ngày làm việc hiệu quả!"
                           styleClass="page-subtitle"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <VBox alignment="CENTER_RIGHT" spacing="3.0">
                    <Label text="Employee" styleClass="account-name"/>
                    <Label text="Nhân viên" styleClass="account-role"/>
                </VBox>
            </HBox>

            <!-- STATISTICS -->
            <GridPane hgap="16.0" vgap="16.0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25.0"/>
                    <ColumnConstraints percentWidth="25.0"/>
                    <ColumnConstraints percentWidth="25.0"/>
                    <ColumnConstraints percentWidth="25.0"/>
                </columnConstraints>

                <VBox GridPane.columnIndex="0"
                      prefHeight="145.0"
                      styleClass="stat-card">
                    <Label text="TỔNG SỐ BÀN" styleClass="stat-title"/>
                    <Label fx:id="totalTableLabel"
                           text="0"
                           styleClass="stat-value"/>
                    <Label fx:id="tableStatusLabel"
                           text="Đã sử dụng: 0   •   Còn trống: 0"
                           styleClass="stat-description"/>
                </VBox>

                <VBox GridPane.columnIndex="1"
                      prefHeight="145.0"
                      styleClass="stat-card">
                    <Label text="ĐƠN HÀNG HÔM NAY" styleClass="stat-title"/>
                    <Label fx:id="todayOrderLabel"
                           text="0"
                           styleClass="stat-value"/>
                    <Label text="Đơn hàng phát sinh hôm nay"
                           styleClass="stat-description"/>
                </VBox>

                <VBox GridPane.columnIndex="2"
                      prefHeight="145.0"
                      styleClass="stat-card">
                    <Label text="DOANH THU HÔM NAY" styleClass="stat-title"/>
                    <Label fx:id="todayRevenueLabel"
                           text="0đ"
                           styleClass="stat-value"/>
                    <Label text="Tổng doanh thu trong ngày"
                           styleClass="stat-description"/>
                </VBox>

                <VBox GridPane.columnIndex="3"
                      prefHeight="145.0"
                      styleClass="stat-card">
                    <Label text="KHÁCH HÀNG HÔM NAY" styleClass="stat-title"/>
                    <Label fx:id="todayCustomerLabel"
                           text="0"
                           styleClass="stat-value"/>
                    <Label text="Số khách hàng đã phục vụ"
                           styleClass="stat-description"/>
                </VBox>
            </GridPane>

            <!-- TABLE + INVENTORY -->
            <HBox spacing="16.0" VBox.vgrow="ALWAYS">

                <!-- TABLE STATUS -->
                <VBox prefWidth="850.0"
                      spacing="12.0"
                      styleClass="content-card"
                      HBox.hgrow="ALWAYS">

                    <HBox alignment="CENTER_LEFT">
                        <Label text="Trạng thái bàn"
                               styleClass="section-title"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <Label fx:id="tableUsageLabel"
                               text="0/0 bàn đang sử dụng"
                               styleClass="filter-label"/>
                    </HBox>

                    <GridPane fx:id="tableStatusGrid"
                              hgap="12.0"
                              vgap="12.0"
                              VBox.vgrow="ALWAYS">

                        <columnConstraints>
                            <ColumnConstraints percentWidth="25.0"/>
                            <ColumnConstraints percentWidth="25.0"/>
                            <ColumnConstraints percentWidth="25.0"/>
                            <ColumnConstraints percentWidth="25.0"/>
                        </columnConstraints>

                        <VBox GridPane.columnIndex="0"
                              GridPane.rowIndex="0"
                              prefHeight="75.0"
                              styleClass="table-card,table-available">
                            <Label text="Bàn 01" styleClass="table-name"/>
                            <Label text="●  Trống" styleClass="table-status"/>
                        </VBox>

                        <VBox GridPane.columnIndex="1"
                              GridPane.rowIndex="0"
                              prefHeight="75.0"
                              styleClass="table-card,table-occupied">
                            <Label text="Bàn 02" styleClass="table-name"/>
                            <Label text="●  Có khách" styleClass="table-status"/>
                        </VBox>

                        <VBox GridPane.columnIndex="2"
                              GridPane.rowIndex="0"
                              prefHeight="75.0"
                              styleClass="table-card,table-available">
                            <Label text="Bàn 03" styleClass="table-name"/>
                            <Label text="●  Trống" styleClass="table-status"/>
                        </VBox>

                        <VBox GridPane.columnIndex="3"
                              GridPane.rowIndex="0"
                              prefHeight="75.0"
                              styleClass="table-card,table-occupied">
                            <Label text="Bàn 04" styleClass="table-name"/>
                            <Label text="●  Có khách" styleClass="table-status"/>
                        </VBox>

                        <VBox GridPane.columnIndex="0"
                              GridPane.rowIndex="1"
                              prefHeight="75.0"
                              styleClass="table-card,table-available">
                            <Label text="Bàn 05" styleClass="table-name"/>
                            <Label text="●  Trống" styleClass="table-status"/>
                        </VBox>

                        <VBox GridPane.columnIndex="1"
                              GridPane.rowIndex="1"
                              prefHeight="75.0"
                              styleClass="table-card,table-available">
                            <Label text="Bàn 06" styleClass="table-name"/>
                            <Label text="●  Trống" styleClass="table-status"/>
                        </VBox>

                        <VBox GridPane.columnIndex="2"
                              GridPane.rowIndex="1"
                              prefHeight="75.0"
                              styleClass="table-card,table-occupied">
                            <Label text="Bàn 07" styleClass="table-name"/>
                            <Label text="●  Có khách" styleClass="table-status"/>
                        </VBox>

                        <VBox GridPane.columnIndex="3"
                              GridPane.rowIndex="1"
                              prefHeight="75.0"
                              styleClass="table-card,table-available">
                            <Label text="Bàn 08" styleClass="table-name"/>
                            <Label text="●  Trống" styleClass="table-status"/>
                        </VBox>

                        <VBox GridPane.columnIndex="0"
                              GridPane.rowIndex="2"
                              prefHeight="75.0"
                              styleClass="table-card,table-available">
                            <Label text="Bàn 09" styleClass="table-name"/>
                            <Label text="●  Trống" styleClass="table-status"/>
                        </VBox>

                        <VBox GridPane.columnIndex="1"
                              GridPane.rowIndex="2"
                              prefHeight="75.0"
                              styleClass="table-card,table-available">
                            <Label text="Bàn 10" styleClass="table-name"/>
                            <Label text="●  Trống" styleClass="table-status"/>
                        </VBox>

                        <VBox GridPane.columnIndex="2"
                              GridPane.rowIndex="2"
                              prefHeight="75.0"
                              styleClass="table-card,table-occupied">
                            <Label text="Bàn 11" styleClass="table-name"/>
                            <Label text="●  Có khách" styleClass="table-status"/>
                        </VBox>

                        <VBox GridPane.columnIndex="3"
                              GridPane.rowIndex="2"
                              prefHeight="75.0"
                              styleClass="table-card,table-available">
                            <Label text="Bàn 12" styleClass="table-name"/>
                            <Label text="●  Trống" styleClass="table-status"/>
                        </VBox>

                    </GridPane>

                    <HBox alignment="CENTER_RIGHT">
                        <Label text="● Trống"
                               styleClass="available-text"/>
                        <Label text="     ● Có khách"
                               styleClass="occupied-text"/>
                    </HBox>
                </VBox>

                <!-- INVENTORY -->
                <VBox prefWidth="350.0"
                      spacing="12.0"
                      styleClass="content-card">

                    <HBox alignment="CENTER_LEFT">
                        <Label text="Cảnh báo tồn kho"
                               styleClass="section-title"/>
                    </HBox>

                    <VBox spacing="12.0">

                        <HBox alignment="CENTER_LEFT"
                              styleClass="inventory-row">
                            <VBox spacing="3.0">
                                <Label text="Cà phê Arabica"
                                       styleClass="inventory-name"/>
                                <Label text="Còn 3 / tối thiểu 10"
                                       styleClass="inventory-description"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Sắp hết"
                                   styleClass="inventory-danger"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT"
                              styleClass="inventory-row">
                            <VBox spacing="3.0">
                                <Label text="Bánh Croissant"
                                       styleClass="inventory-name"/>
                                <Label text="Còn 5 / tối thiểu 10"
                                       styleClass="inventory-description"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Sắp hết"
                                   styleClass="inventory-danger"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT"
                              styleClass="inventory-row">
                            <VBox spacing="3.0">
                                <Label text="Nước cam"
                                       styleClass="inventory-name"/>
                                <Label text="Còn 2 / tối thiểu 8"
                                       styleClass="inventory-description"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Sắp hết"
                                   styleClass="inventory-danger"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT"
                              styleClass="inventory-row">
                            <VBox spacing="3.0">
                                <Label text="Trà xanh"
                                       styleClass="inventory-name"/>
                                <Label text="Còn 8 / tối thiểu 10"
                                       styleClass="inventory-description"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Thấp"
                                   styleClass="inventory-warning"/>
                        </HBox>
                    </VBox>

                    <Region VBox.vgrow="ALWAYS"/>

                    <Button text="Xem kho →"
                            maxWidth="1.7976931348623157E308"
                            prefHeight="42.0"
                            styleClass="secondary-button"
                            onAction="#openInventoryManagement"/>
                </VBox>
            </HBox>

        </VBox>
    </center>
</BorderPane>