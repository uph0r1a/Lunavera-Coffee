<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane fx:id="dashboardRoot"
            prefWidth="1600.0"
            prefHeight="1000.0"
            minWidth="1600.0"
            minHeight="1000.0"
            maxWidth="1600.0"
            maxHeight="1000.0"
            stylesheets="@../css/admin-trangchu.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.controller.AdminController"
            styleClass="dashboard">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="270.0"
              maxWidth="270.0"
              styleClass="sidebar">

            <VBox alignment="CENTER" prefHeight="150.0">
                <ImageView fitHeight="100.0" fitWidth="180.0" preserveRatio="true">
                    <image>
                        <Image url="@../images/background/LunaveraLogo.png"/>
                    </image>
                </ImageView>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <VBox spacing="6.0" VBox.vgrow="NEVER">
                <Button text="⌂   Trang chủ"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button,menu-button-active"/>

                <Button text="▣   Quản lý sản phẩm"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openProductManagement"/>

                <Button text="▤   Quản lý đơn hàng"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openOrderManagement"/>

                <Button text="♙   Quản lý khách hàng"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openCustomerManagement"/>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <VBox spacing="6.0">
                <Button text="▦   Quản lý danh mục"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openCategoryManagement"/>

            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <VBox spacing="6.0">

                <Button text="♙   Quản lý tài khoản"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openAccountManagement"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox alignment="CENTER_LEFT" spacing="8.0">
                <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                </padding>
                <Button text="←   Đăng xuất"
                        prefHeight="42.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="logout-button"
                        onAction="#logout"/>

                <Label text="Cà phê ngon&#10;Ngày thêm tốt đẹp"
                       styleClass="sidebar-footer"/>
            </VBox>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="20.0" styleClass="content">

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT" prefHeight="70.0">
                <VBox spacing="4.0">
                    <Label fx:id="dashboardGreetingLabel" text="Chào mừng, Admin!" styleClass="page-title"/>
                    <Label text="Chúc bạn có một ngày làm việc hiệu quả!"
                           styleClass="page-subtitle"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="backupButton"
                        text="⤓  Sao lưu dữ liệu"
                        prefHeight="42.0"
                        styleClass="secondary-button"
                        onAction="#handleBackupData"/>
                <Region prefWidth="10.0"/>

                <Button fx:id="reportButton"
                        text="▤  Báo cáo doanh thu"
                        prefHeight="42.0"
                        styleClass="primary-button"
                        onAction="#handleShowReports"/>
                <Region prefWidth="16.0"/>

                <VBox alignment="CENTER_RIGHT" spacing="3.0">
                    <Label fx:id="dashboardAccountNameLabel" text="Admin" styleClass="account-name"/>
                    <Label text="Quản trị viên" styleClass="account-role"/>
                </VBox>
            </HBox>

            <!-- STATISTICS -->
            <GridPane hgap="16.0" vgap="16.0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25.0"/>
                    <ColumnConstraints percentWidth="25.0"/>
                    <ColumnConstraints percentWidth="25.0"/>
                    <ColumnConstraints percentWidth="25.0"/>
                </columnConstraints>

                <VBox GridPane.columnIndex="0"
                      prefHeight="145.0"
                      styleClass="stat-card">
                    <Label text="SẢN PHẨM" styleClass="stat-title"/>
                    <Label fx:id="dashboardProductCountLabel"
                           text="0"
                           styleClass="stat-value"/>
                    <Label fx:id="dashboardLowStockNoteLabel"
                           text="Đang tải..."
                           styleClass="stat-description"/>
                </VBox>

                <VBox GridPane.columnIndex="1"
                      prefHeight="145.0"
                      styleClass="stat-card">
                    <Label text="ĐƠN HÀNG HÔM NAY" styleClass="stat-title"/>
                    <Label fx:id="todayOrderLabel"
                           text="0"
                           styleClass="stat-value"/>
                    <Label text="Đơn hàng phát sinh hôm nay"
                           styleClass="stat-description"/>
                </VBox>

                <VBox GridPane.columnIndex="2"
                      prefHeight="145.0"
                      styleClass="stat-card">
                    <Label text="DOANH THU HÔM NAY" styleClass="stat-title"/>
                    <Label fx:id="todayRevenueLabel"
                           text="0đ"
                           styleClass="stat-value"/>
                    <Label text="Tổng doanh thu trong ngày"
                           styleClass="stat-description"/>
                </VBox>

                <VBox GridPane.columnIndex="3"
                      prefHeight="145.0"
                      styleClass="stat-card">
                    <Label text="KHÁCH HÀNG HÔM NAY" styleClass="stat-title"/>
                    <Label fx:id="todayCustomerLabel"
                           text="0"
                           styleClass="stat-value"/>
                    <Label text="Số khách hàng đã phục vụ"
                           styleClass="stat-description"/>
                </VBox>
            </GridPane>

            <!-- MAIN DASHBOARD CONTENT (2 COLUMNS) -->
            <HBox spacing="16.0" VBox.vgrow="ALWAYS">

                <!-- LEFT COLUMN: LINE CHART + DINING TABLE GRID -->
                <VBox spacing="16.0" HBox.hgrow="ALWAYS">

                    <!-- DOANH THU 7 NGÀY GẦN ĐÂY -->
                    <VBox prefHeight="280.0"
                          spacing="12.0"
                          styleClass="content-card">

                        <HBox alignment="CENTER_LEFT">
                            <Label text="Doanh thu 7 ngày gần đây"
                                   styleClass="section-title"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label text="7 ngày qua"
                                   styleClass="filter-label"/>
                        </HBox>

                        <LineChart fx:id="revenueChart"
                                   animated="false"
                                   legendVisible="false"
                                   createSymbols="true"
                                   verticalGridLinesVisible="false"
                                   horizontalGridLinesVisible="true"
                                   VBox.vgrow="ALWAYS">

                            <xAxis>
                                <CategoryAxis fx:id="revenueXAxis"
                                              label="Ngày"/>
                            </xAxis>

                            <yAxis>
                                <NumberAxis fx:id="revenueYAxis"
                                            label="Doanh thu"/>
                            </yAxis>
                        </LineChart>
                    </VBox>

                    <!-- SƠ ĐỒ BÀN PHỤC VỤ -->
                    <VBox spacing="14.0"
                          styleClass="content-card"
                          VBox.vgrow="ALWAYS">

                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <VBox spacing="3.0">
                                <Label text="Sơ đồ bàn phục vụ"
                                       styleClass="section-title"/>
                                <Label text="Chọn bàn để tạo hoặc xem đơn"
                                       styleClass="section-subtitle"/>
                            </VBox>

                            <Region HBox.hgrow="ALWAYS"/>

                            <!-- STATUS LEGENDS -->
                            <HBox spacing="14.0" alignment="CENTER">
                                <HBox spacing="6.0" alignment="CENTER">
                                    <Label text="●" styleClass="status-dot-occupied"/>
                                    <Label text="Có đơn" styleClass="status-legend-text"/>
                                </HBox>

                                <HBox spacing="6.0" alignment="CENTER">
                                    <Label text="●" styleClass="status-dot-empty"/>
                                    <Label text="Không đơn" styleClass="status-legend-text"/>
                                </HBox>
                            </HBox>
                        </HBox>

                        <!-- GRID BÀN (3x4 = 12 BÀN) -->
                        <GridPane fx:id="homeTableGrid"
                                  hgap="12.0"
                                  vgap="12.0"
                                  VBox.vgrow="ALWAYS">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="33.333" hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="33.333" hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="33.333" hgrow="ALWAYS"/>
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="78.0" prefHeight="88.0" vgrow="ALWAYS"/>
                                <RowConstraints minHeight="78.0" prefHeight="88.0" vgrow="ALWAYS"/>
                                <RowConstraints minHeight="78.0" prefHeight="88.0" vgrow="ALWAYS"/>
                                <RowConstraints minHeight="78.0" prefHeight="88.0" vgrow="ALWAYS"/>
                            </rowConstraints>
                        </GridPane>
                    </VBox>
                </VBox>

                <!-- RIGHT COLUMN: THỐNG KÊ ĐƠN HÀNG HÔM NAY (KÉO DÀI HẾT CHIỀU CAO) -->
                <VBox prefWidth="360.0"
                      minWidth="340.0"
                      maxWidth="380.0"
                      spacing="14.0"
                      styleClass="content-card"
                      VBox.vgrow="ALWAYS">

                    <Label text="Thống kê đơn hàng hôm nay"
                           styleClass="section-title"/>

                    <!-- 3 TRẠNG THÁI ĐƠN -->
                    <VBox spacing="10.0" styleClass="order-summary-box">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Đã thanh toán"
                                   styleClass="order-status-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="paidOrderLabel"
                                   text="0"
                                   styleClass="order-status-value"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT">
                            <Label text="Đang mở"
                                   styleClass="order-status-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="openOrderLabel"
                                   text="0"
                                   styleClass="order-status-value"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT">
                            <Label text="Đã hủy"
                                   styleClass="order-status-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="cancelledOrderLabel"
                                   text="0"
                                   styleClass="order-status-value"/>
                        </HBox>
                    </VBox>

                    <!-- TIÊU ĐỀ PHẦN DANH SÁCH ĐƠN HÀNG HÔM NAY -->
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Đơn hàng trong ngày"
                               styleClass="section-subtitle"
                               style="-fx-font-weight: bold; -fx-text-fill: #274917;"/>
                    </HBox>

                    <!-- DANH SÁCH ĐƠN HÀNG TRONG NGÀY (SCROLLPANE) -->
                    <ScrollPane fitToWidth="true"
                                hbarPolicy="NEVER"
                                vbarPolicy="AS_NEEDED"
                                styleClass="today-orders-scroll"
                                VBox.vgrow="ALWAYS">
                        <VBox fx:id="todayOrdersContainer"
                              spacing="8.0"
                              styleClass="today-orders-container"/>
                    </ScrollPane>

                    <Button text="Xem tất cả đơn hàng →"
                            maxWidth="1.7976931348623157E308"
                            prefHeight="42.0"
                            styleClass="secondary-button"
                            onAction="#openOrderManagement"/>
                </VBox>
            </HBox>

        </VBox>
    </center>
</BorderPane>