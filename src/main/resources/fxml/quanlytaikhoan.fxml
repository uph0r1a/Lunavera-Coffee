<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane fx:id="QuanLyTaiKhoanRoot" maxHeight="1000" maxWidth="1600" prefHeight="1000" prefWidth="1600" stylesheets="@../css/quanlytaikhoan.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.AdminController">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="270.0"
              maxWidth="270.0"
              styleClass="sidebar">

            <VBox alignment="CENTER" prefHeight="150.0">
                <ImageView fitHeight="100.0" fitWidth="180.0" preserveRatio="true">
                    <image>
                        <Image url="@../images/LunaveraLogo.png"/>
                    </image>
                </ImageView>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <VBox spacing="6.0" VBox.vgrow="NEVER">
                <Button text="⌂   Trang chủ"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openDashboard"/>

                <Button text="▣   Quản lý sản phẩm"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openProductManagement"/>

                <Button text="▤   Quản lý đơn hàng"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openOrderManagement"/>

                <Button text="♙   Quản lý khách hàng"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openCustomerManagement"/>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <VBox spacing="6.0">
                <Button text="▦   Quản lý danh mục"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openCategoryManagement"/>

                <Button text="▣   Quản lý kho"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openInventoryManagement"/>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <VBox spacing="6.0">
                <Button text="♙   Quản lý nhân viên"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openEmployeeManagement"/>

                <Button text="♙   Quản lý tài khoản"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button,menu-button-active"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox alignment="CENTER_LEFT" spacing="8.0">
                <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                </padding>
                <Button text="←   Đăng xuất"
                        prefHeight="42.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="logout-button"
                        onAction="#logout"/>

                <Label text="Cà phê ngon&#10;Ngày thêm tốt đẹp"
                       styleClass="sidebar-footer"/>
            </VBox>
        </VBox>
    </left>

    <!-- ================= MAIN CONTENT ================= -->
    <center>
        <VBox styleClass="content">

            <!-- ================= HEADER ================= -->
            <HBox alignment="CENTER_LEFT" prefHeight="72" spacing="10" styleClass="page-header">

                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label styleClass="page-title" text="Quản lý tài khoản" />
                    <Label styleClass="page-description" text="Quản lý tài khoản nhân viên và phân quyền hệ thống" />
                </VBox>

                <Label styleClass="header-icon" text="♧" />

                <VBox alignment="CENTER_RIGHT" spacing="2">
                    <Label styleClass="admin-name" text="Admin" />
                    <Label styleClass="admin-role" text="Quản trị viên" />
                </VBox>

                <Label styleClass="profile-icon" text="◎" />
            </HBox>

            <!-- ================= STATISTICS ================= -->
            <HBox spacing="12" styleClass="statistics">
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="stat-icon" text="●" />
                    <Label styleClass="stat-title" text="Tổng tài khoản" />
                    <Label fx:id="totalAccountLabel" styleClass="stat-value" text="0" />
                    <Label styleClass="stat-description" text="Tài khoản hệ thống" />
                </VBox>

                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="stat-icon-active" text="●" />
                    <Label styleClass="stat-title" text="Đang hoạt động" />
                    <Label fx:id="activeAccountLabel" styleClass="stat-value" text="0" />
                    <Label styleClass="stat-description" text="Tài khoản sẵn sàng" />
                </VBox>

                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="stat-icon-locked" text="●" />
                    <Label styleClass="stat-title" text="Đã khóa" />
                    <Label fx:id="lockedAccountLabel" styleClass="stat-value" text="0" />
                    <Label styleClass="stat-description" text="Tài khoản ngưng kích hoạt" />
                </VBox>

                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="stat-icon" text="⬟" />
                    <Label styleClass="stat-title" text="Quản trị viên (Owner)" />
                    <Label fx:id="adminAccountLabel" styleClass="stat-value" text="0" />
                    <Label styleClass="stat-description" text="Tài khoản toàn quyền" />
                </VBox>
            </HBox>

            <!-- ================= SEARCH + FILTER ================= -->
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="search-bar">
                <TextField fx:id="accountSearchField" onAction="#handleAccountSearch" promptText="Tìm kiếm username, họ tên, số điện thoại..." styleClass="search-field" HBox.hgrow="ALWAYS" />

                <ComboBox fx:id="roleFilter" onAction="#handleFilterChange" prefWidth="145" promptText="Tất cả quyền" styleClass="filter-combo" />

                <ComboBox fx:id="accountStatusFilter" onAction="#handleFilterChange" prefWidth="150" promptText="Tất cả trạng thái" styleClass="filter-combo" />

                <Button fx:id="addAccountButton" mnemonicParsing="false" onAction="#handleAddAccount" styleClass="primary-button" text="+   Thêm tài khoản" />
            </HBox>

            <!-- ================= ACCOUNT AREA ================= -->
            <HBox spacing="12" styleClass="account-area" VBox.vgrow="ALWAYS">

                <!-- ================= ACCOUNT TABLE ================= -->
                <VBox spacing="10" styleClass="table-card" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="section-title" text="●   Danh sách tài khoản" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="accountCountLabel" styleClass="account-count" text="0 tài khoản" />
                    </HBox>

                    <!-- Table: Đã thêm cột fullNameColumn và sự kiện onMouseClicked -->
                    <TableView fx:id="accountTable" onMouseClicked="#handleSelectAccount" styleClass="account-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="accountIndexColumn" prefWidth="45" text="#" />
                            <TableColumn fx:id="usernameColumn" prefWidth="130" text="Tài khoản" />
                            <TableColumn fx:id="fullNameColumn" prefWidth="150" text="Họ và tên" />
                            <TableColumn fx:id="phoneColumn" prefWidth="120" text="Số điện thoại" />
                            <TableColumn fx:id="roleColumn" prefWidth="105" text="Quyền" />
                            <TableColumn fx:id="statusColumn" prefWidth="110" text="Trạng thái" />
                            <TableColumn fx:id="createdDateColumn" prefWidth="125" text="Ngày tạo" />
                            <TableColumn fx:id="accountActionColumn" prefWidth="110" text="Thao tác" />
                        </columns>
                        <placeholder>
                            <Label styleClass="empty-label" text="Chưa có tài khoản" />
                        </placeholder>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>

                    <!-- ================= PAGINATION ================= -->
                    <HBox alignment="CENTER_LEFT" spacing="5">
                        <Label fx:id="accountPaginationLabel" styleClass="table-footer" text="Hiển thị 0 – 0 / 0 tài khoản" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="previousPageButton" mnemonicParsing="false" onAction="#handlePreviousAccountPage" styleClass="page-button" text="‹" />
                        <Button fx:id="pageOneButton" mnemonicParsing="false" onAction="#handleAccountPageOne" styleClass="page-button,page-button-active" text="1" />
                        <Button fx:id="nextPageNumberButton" mnemonicParsing="false" onAction="#handleAccountPageTwo" styleClass="page-button" text="2" />
                        <Button fx:id="nextPageButton" mnemonicParsing="false" onAction="#handleNextAccountPage" styleClass="page-button" text="›" />
                    </HBox>
                </VBox>

                <!-- ================= ACCOUNT DETAIL ================= -->
                <VBox fx:id="accountDetailCard" maxWidth="300" minWidth="300" prefWidth="300" spacing="12" styleClass="detail-card">

                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="section-title" text="▣   Chi tiết tài khoản" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button fx:id="closeDetailButton" mnemonicParsing="false" onAction="#handleCloseDetail" styleClass="close-button" text="×" />
                    </HBox>

                    <!-- ================= PROFILE ================= -->
                    <VBox alignment="CENTER" spacing="5" styleClass="profile-box">
                        <Label fx:id="detailAvatar" styleClass="avatar" text="●" />
                        <Label fx:id="detailUsername" styleClass="profile-name" text="Chưa chọn" />
                        <Label fx:id="detailRole" styleClass="role-badge" text="Chưa có" />
                    </VBox>

                    <!-- ================= INFORMATION ================= -->
                    <VBox spacing="10" styleClass="info-box">
                        <HBox>
                            <Label styleClass="info-label" text="Tên đăng nhập" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="detailUsernameLabel" styleClass="info-value" text="-" />
                        </HBox>

                        <!-- Đã bổ sung Họ và tên -->
                        <HBox>
                            <Label styleClass="info-label" text="Họ và tên" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="detailFullNameLabel" styleClass="info-value" text="-" />
                        </HBox>

                        <HBox>
                            <Label styleClass="info-label" text="Số điện thoại" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="detailPhoneLabel" styleClass="info-value" text="-" />
                        </HBox>

                        <HBox>
                            <Label styleClass="info-label" text="Quyền hạn" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="detailRoleLabel" styleClass="role-badge" text="-" />
                        </HBox>

                        <HBox>
                            <Label styleClass="info-label" text="Trạng thái" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="detailStatusLabel" styleClass="status-active" text="-" />
                        </HBox>

                        <HBox>
                            <Label styleClass="info-label" text="Ngày tạo" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="detailCreatedDateLabel" styleClass="info-value" text="-" />
                        </HBox>
                    </VBox>

                    <!-- ================= PERMISSION ================= -->
                    <Label styleClass="permission-title" text="⬟   Phân quyền" />
                    <VBox fx:id="permissionBox" spacing="6" styleClass="permission-box">
                        <Label styleClass="permission-item" text="Chưa chọn tài khoản" />
                    </VBox>

                    <Region VBox.vgrow="ALWAYS" />

                    <!-- ================= ACTIONS ================= -->
                    <HBox spacing="8">
                        <Button fx:id="editAccountButton" mnemonicParsing="false" onAction="#handleEditAccount" styleClass="secondary-button" text="✎   Chỉnh sửa" HBox.hgrow="ALWAYS" />

                        <Button fx:id="lockAccountButton" mnemonicParsing="false" onAction="#handleLockAccount" styleClass="danger-button" text="▣   Khóa" HBox.hgrow="ALWAYS" />
                    </HBox>

                </VBox>

            </HBox>

        </VBox>
    </center>

</BorderPane>
